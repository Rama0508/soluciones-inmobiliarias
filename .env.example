# =============================================
# WHATSAPP AI AGENT KIT — Variables de entorno
# Copia este fichero a .env.local y rellénalo.
# =============================================

# --------------------------------------------------
# OBLIGATORIO: API key de OpenRouter
# Consíguela en https://openrouter.ai/keys
# Formato: sk-or-v1-...
# El bot ABORTARÁ al arrancar si esta variable falta o está vacía.
# --------------------------------------------------
OPENROUTER_API_KEY=

# --------------------------------------------------
# Modelo de IA a usar (tiene valor por defecto si lo omites)
# Default: openai/gpt-4o-mini
# Recomendados:
#   openai/gpt-4o-mini          (equilibrio calidad/precio)
#   anthropic/claude-haiku-4-5  (rápido, muy bueno en español)
#   google/gemini-2.5-flash     (alternativa económica)
#
# ⚠️  NUNCA uses modelos ":free" (p.ej. openai/gpt-4o-mini:free)
#     Están saturados y dan errores 429 en producción.
# --------------------------------------------------
OPENROUTER_MODEL=openai/gpt-4o-mini

# --------------------------------------------------
# Webhook de Google Sheets para guardar leads
# (Opcional — la tool guardarLead queda inactiva si está vacío)
# Crea un Google Apps Script con doPost() y pega la URL aquí.
# --------------------------------------------------
GOOGLE_SHEETS_WEBHOOK_URL=

# --------------------------------------------------
# URL de Cal.com o Calendly para agendar llamadas
# (Opcional — la tool agendar queda inactiva si está vacío)
# Ejemplo: https://cal.com/tu-usuario/diagnostico
# /personaliza te ayuda a configurarlo.
# --------------------------------------------------
CAL_BOOKING_URL=

# --------------------------------------------------
# Puerto del dashboard Next.js (producción)
# Default: 3000
# --------------------------------------------------
PORT=3000

# --------------------------------------------------
# Nivel de logs del bot (silent|error|warn|info|debug)
# Default: info
# (El logger interno de Baileys va siempre en silent)
# --------------------------------------------------
LOG_LEVEL=info
